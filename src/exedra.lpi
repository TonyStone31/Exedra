<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="exedra"/>
      <UseAppBundle Value="False"/>
    </General>
    <BuildModes>
      <Item Name="Server" Default="True"/>
      <Item Name="CGI">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="../bin/exedra.cgi"/>
          </Target>
          <SearchPaths>
            <UnitOutputDirectory Value="../lib/cgi/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <Other>
            <CustomOptions Value="-dCGI"/>
          </Other>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <RequiredPackages>
      <Item>
        <PackageName Value="CryptoLib4PascalPackage"/>
      </Item>
      <Item>
        <PackageName Value="HashLib4PascalPackage"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="exedra.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatdb.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatbell.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatmarkup.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatusers.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatroles.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatrooms.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatfiles.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatmessages.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatcommands.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatprivate.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatadmin.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatlive.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="chatpoll.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="webpages.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../bin/exedra"/>
    </Target>
    <SearchPaths>
      <UnitOutputDirectory Value="../lib/server/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <Optimizations>
        <OptimizationLevel Value="2"/>
      </Optimizations>
    </CodeGeneration>
  </CompilerOptions>
</CONFIG>
